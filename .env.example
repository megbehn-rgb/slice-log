# Google Cloud Console -> APIs & Services -> Credentials
# Enable "Places API (New)" on the same project before using this key.
# See README.md for how to restrict this key to your app.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your-api-key-here

# Supabase project -> Settings -> API. See README.md for full setup steps
# (SQL to run, storage bucket to create). Both people share these same
# values -- this is a shared backend, not per-device config.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
